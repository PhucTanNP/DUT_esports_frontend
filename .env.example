# =====================
# DUT Esports Frontend (Next.js)
# Sao chép thành .env.local và sửa theo môi trường deploy
# =====================

# Base URL API backend (bắt buộc trên Vercel — trỏ đến backend thật)
NEXT_PUBLIC_API_BASE=https://your-backend.vercel.app/api

# Origin API backend (dùng cho logo game, banner upload)
NEXT_PUBLIC_API_ORIGIN=https://your-backend.vercel.app
